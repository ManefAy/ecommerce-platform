# Copy this file, rename it to application.properties, and fill in your values

spring.application.name=ecommerce
server.port=8080

# DATABASE
spring.datasource.url=jdbc:mysql://localhost:3306/ecommerce_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=YOUR_MYSQL_USERNAME
spring.datasource.password=YOUR_MYSQL_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA
# Do NOT set hibernate.dialect: Hibernate picks the MySQL dialect on its own,
# and the old MySQL8Dialect class makes the app crash at startup.
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.open-in-view=false

# JWT
# Must be a Base64 string of at least 32 bytes (256 bits). Generate one with:
#   openssl rand -base64 32
jwt.secret=PASTE_OUTPUT_OF_openssl_rand_base64_32
jwt.expiration=86400000

# DELIVERY API
delivery.api.base-url=https://api.your-delivery-company.com
delivery.api.key=YOUR_DELIVERY_API_KEY

# META CAPI
# Leave the placeholders as they are to stay in simulation mode (nothing is sent to Meta)
meta.capi.access-token=YOUR_META_ACCESS_TOKEN
meta.capi.pixel-id=YOUR_PIXEL_ID

# CLOUDINARY (product images)
cloudinary.cloud-name=YOUR_CLOUDINARY_CLOUD_NAME
cloudinary.api-key=YOUR_CLOUDINARY_API_KEY
cloudinary.api-secret=YOUR_CLOUDINARY_API_SECRET

# FILE UPLOAD
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=10MB